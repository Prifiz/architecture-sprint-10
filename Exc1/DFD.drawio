        <mxCell id="8ZHcWAwmlswioZH3aga5-2" value="&lt;b&gt;Шифрование&lt;/b&gt;:&lt;br&gt;данные бухгалтерии должны быть&lt;br&gt;аналогично зашифрованы&lt;br&gt;во избежание раскрытия сотрудникам ТМЦ&lt;br&gt;(например зарплаты, данные оплат&lt;br&gt;должен видеть только бухгалтер)" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
