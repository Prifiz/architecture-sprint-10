        <mxCell id="8ZHcWAwmlswioZH3aga5-1" value="&lt;b&gt;Шифрование&lt;/b&gt;:&lt;br&gt;процесс учета ТМЦ&lt;br&gt;должен быть отделен от бухучета,&lt;br&gt;исключая взаимное вмешательство" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
