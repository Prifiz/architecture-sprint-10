        <mxCell id="9-AXKle4vPfBeWUvj7ij-2" value="Общий файловый сервер" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontStyle=1" parent="1" vertex="1">
